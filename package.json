{
  "name": "pawns-of-olympus",
  "private": true,
  "version": "0.1.0",
  "description": "Pawns of Olympus: a turn-based tactics puzzle set in the Trojan War.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "validate-levels": "vite-node tools/validate-levels.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "export-sprites": "playwright test --config playwright.export.config.ts",
    "package:itch": "node tools/package-itch.mjs",
    "check": "node tools/check.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
